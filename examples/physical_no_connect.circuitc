design physical_no_connect {
  net TEST;
  ground GND;
  module board_only {}

  dc_source board_only.anchor V1 {
    part "dc_voltage_source" virtual;
    symbol "CircuitC:VDC" {
      bind p 1 passive;
      bind n 2 passive;
    }
    model "spice:Vdc";
    schematic at (60.96 mm, 81.28 mm) rotation 0 deg;
    voltage 1 V;
    terminals p n;
    connect p TEST;
    connect n GND;
  }

  resistor board_only.unused R1 {
    part "resistor" manufacturer "Yageo" number "RC0603FR-0710KL" package "0603_1608Metric";
    lifecycle active;
    sourcing minimum_available 1 maximum_lead_time_days 365 region "global";
    symbol "CircuitC:R" {
      bind 1 1 passive;
      bind 2 2 passive;
    }
    schematic at (81.28 mm, 81.28 mm) rotation 90 deg;
    resistance 10 kohm;
    connect 1 TEST;
    no_connect 2;
    footprint "CircuitC:R_0603_1608Metric" {
      bind 1 1;
      bind 2 2;
    }
  }

  resistor board_only.load R2 {
    part "resistor" manufacturer "Yageo" number "RC0603FR-0710KL" package "0603_1608Metric";
    lifecycle active;
    sourcing minimum_available 1 maximum_lead_time_days 365 region "global";
    symbol "CircuitC:R" {
      bind 1 1 passive;
      bind 2 2 passive;
    }
    model "spice:R";
    schematic at (60.96 mm, 101.6 mm) rotation 0 deg;
    resistance 10 kohm;
    terminals 1 2;
    connect 1 TEST;
    connect 2 GND;
    footprint "CircuitC:R_0603_1608Metric" {
      bind 1 1;
      bind 2 2;
    }
  }

  catalog_snapshot "reference-catalog-2026-08-04" sha256 "1631bcee4da9ee39aa8af85f1f80c79331b22bff390a15d4e02b7e3decc2c69e" evaluated_on "2026-08-04";

  variant production build_quantity 1 {
    fit board_only.unused;
    fit board_only.load;
    configure assembly_revision "A";
  }

  board {
    rectangle at (0 mm, 0 mm) size (10 mm, 10 mm);
    place R1 at (5 mm, 5 mm) rotation 0 deg layer front;
    place R2 at (5 mm, 8 mm) rotation 0 deg layer front;
    route board.routes.test_tie net TEST from (4 mm, 5 mm) to (4 mm, 8 mm) width 0.25 mm layer front;
  }
}
