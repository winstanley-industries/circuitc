design voltage_divider {
  net VIN;
  net VOUT;
  ground GND;

  module divider {
    port input VIN passive connect VIN;
    port output VOUT passive connect VOUT;
    port input GND passive connect GND;
  }

  module divider.analysis {
    port output VIN power_output connect VIN;
    port input GND passive connect GND;
  }

  resistor divider.r_top R1 {
    part "resistor" manufacturer "Yageo" number "RC0603FR-0710KL" package "0603_1608Metric";
    lifecycle active;
    sourcing minimum_available 1 maximum_lead_time_days 365 region "global";
    substitute manufacturer "Panasonic" number "ERJ-3EKF1002V" package "0603_1608Metric";
    symbol "CircuitC:R" {
      bind 1 1 passive;
      bind 2 2 passive;
    }
    model "spice:R";
    schematic at (81.28 mm, 81.28 mm) rotation 0 deg;
    resistance 10 kohm;
    terminals 1 2;
    connect 1 VIN;
    connect 2 VOUT;
    footprint "CircuitC:R_0603_1608Metric" {
      bind 1 1;
      bind 2 2;
    }
  }

  resistor divider.r_bottom R2 {
    part "resistor" manufacturer "Yageo" number "RC0603FR-0710KL" package "0603_1608Metric";
    lifecycle active;
    sourcing minimum_available 1 maximum_lead_time_days 365 region "global";
    substitute manufacturer "Panasonic" number "ERJ-3EKF1002V" package "0603_1608Metric";
    symbol "CircuitC:R" {
      bind 1 1 passive;
      bind 2 2 passive;
    }
    model "spice:R";
    schematic at (101.6 mm, 81.28 mm) rotation 0 deg;
    resistance 10 kohm;
    terminals 1 2;
    connect 1 VOUT;
    connect 2 GND;
    footprint "CircuitC:R_0603_1608Metric" {
      bind 1 1;
      bind 2 2;
    }
  }

  dc_source divider.analysis.input V1 {
    part "dc_voltage_source" virtual;
    symbol "CircuitC:VDC" {
      bind p 1 passive;
      bind n 2 passive;
    }
    model "spice:Vdc";
    schematic at (60.96 mm, 81.28 mm) rotation 0 deg;
    voltage 10 V;
    terminals p n;
    connect p VIN;
    connect n GND;
  }

  catalog_snapshot "reference-catalog-2026-08-04" sha256 "1631bcee4da9ee39aa8af85f1f80c79331b22bff390a15d4e02b7e3decc2c69e" evaluated_on "2026-08-04";

  variant production build_quantity 10 {
    fit divider.r_top;
    fit divider.r_bottom;
    configure assembly_revision "A";
  }

  variant prototype_alternate build_quantity 2 {
    alternate divider.r_top manufacturer "Panasonic" number "ERJ-3EKF1002V" package "0603_1608Metric";
    not_fitted divider.r_bottom;
    configure assembly_revision "PROTO-ALT";
  }

  manufacturability release.manufacturability adapter "kicad" version "10" {
    assert release.manufacturability.erc capability erc_clean;
    assert release.manufacturability.drc capability drc_clean;
    assert release.manufacturability.unconnected capability unconnected_clean;
    assert release.manufacturability.parity capability schematic_parity_clean;
    assert release.manufacturability.fabrication capability fabrication_inventory_complete;
  }

  board {
    rectangle at (0 mm, 0 mm) size (40 mm, 20 mm);
    place R1 at (15 mm, 10 mm) rotation 0 deg layer front;
    place R2 at (25 mm, 10 mm) rotation 0 deg layer front;
    route board.routes.vout_bridge net VOUT from (16 mm, 10 mm) to (24 mm, 10 mm) width 0.25 mm layer front;
  }
}
