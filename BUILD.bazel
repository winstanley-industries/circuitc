load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:ohmnivore_pin.bzl", "OHMNIVORE_SOURCE_REVISION")

package(default_visibility = ["//visibility:private"])

RUSTC_FLAGS = ["-Dwarnings"]

rust_library(
    name = "circuitc",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["libraries/**"]) + [
        "examples/physical_no_connect.circuitc",
        "examples/voltage_divider.circuitc",
    ],
    crate_name = "circuitc",
    crate_root = "src/lib.rs",
    data = [
        ":ohmnivore_executable",
        ":ohmnivore_provenance",
    ],
    edition = "2024",
    rustc_env = {
        "CIRCUITC_OHMNIVORE_SOURCE_REVISION": OHMNIVORE_SOURCE_REVISION,
    },
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "@crates//libc",
        "@crates//serde",
        "@crates//serde_json",
        "@crates//sha2",
    ],
)

rust_binary(
    name = "ohmnivore_provenance_writer",
    srcs = ["tools/simulation/provenance_writer.rs"],
    crate_name = "ohmnivore_provenance_writer",
    edition = "2024",
    rustc_env = {
        "CIRCUITC_OHMNIVORE_SOURCE_REVISION": OHMNIVORE_SOURCE_REVISION,
    },
    rustc_flags = RUSTC_FLAGS,
    deps = ["@crates//sha2"],
)

genrule(
    name = "ohmnivore_executable",
    srcs = ["@crates//:ohmnivore__ohmnivore"],
    outs = ["ohmnivore-cpu"],
    cmd = "cp $(location @crates//:ohmnivore__ohmnivore) $@ && chmod 0555 $@",
    executable = True,
)

genrule(
    name = "ohmnivore_provenance",
    srcs = [":ohmnivore_executable"],
    outs = ["ohmnivore-provenance.txt"],
    cmd = "$(location :ohmnivore_provenance_writer) $(location :ohmnivore_executable) $@",
    tools = [":ohmnivore_provenance_writer"],
)

rust_binary(
    name = "simulation_runner_gate",
    testonly = True,
    srcs = ["tools/simulation/runner_gate.rs"],
    crate_name = "simulation_runner_gate",
    edition = "2024",
    rustc_flags = RUSTC_FLAGS,
    deps = [":circuitc"],
)

sh_test(
    name = "ohmnivore_cpu_test",
    srcs = ["tools/simulation/ohmnivore_cpu_test.sh"],
    args = ["$(location :simulation_runner_gate)"],
    data = [":simulation_runner_gate"],
)

sh_test(
    name = "ohmnivore_pin_test",
    srcs = ["tools/simulation/ohmnivore_pin_test.sh"],
    args = [
        OHMNIVORE_SOURCE_REVISION,
        "$(location MODULE.bazel)",
        "$(location MODULE.bazel.lock)",
    ],
    data = [
        "MODULE.bazel",
        "MODULE.bazel.lock",
    ],
)

rust_test(
    name = "circuitc_test",
    crate = ":circuitc",
    rustc_flags = RUSTC_FLAGS,
)

rust_binary(
    name = "voltage_divider",
    srcs = ["examples/voltage_divider.rs"],
    crate_name = "voltage_divider",
    edition = "2024",
    rustc_flags = RUSTC_FLAGS,
    deps = [":circuitc"],
)

rust_binary(
    name = "frontend_equivalence",
    testonly = True,
    srcs = ["tools/frontend/equivalence.rs"],
    crate_name = "frontend_equivalence",
    edition = "2024",
    rustc_flags = RUSTC_FLAGS,
    deps = [":circuitc"],
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":circuitc",
        ":frontend_equivalence",
        ":ohmnivore_provenance_writer",
        ":simulation_runner_gate",
        ":voltage_divider",
        "//cmd/circuitc",
    ],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":circuitc",
        ":frontend_equivalence",
        ":ohmnivore_provenance_writer",
        ":simulation_runner_gate",
        ":voltage_divider",
        "//cmd/circuitc",
    ],
)

sh_test(
    name = "frontend_cli_test",
    srcs = ["tools/frontend/cli_test.sh"],
    args = [
        "$(location //cmd/circuitc)",
        "$(location examples/voltage_divider.circuitc)",
        "$(location tools/frontend/fixtures/duplicate_net.circuitc)",
        "$(location tools/frontend/fixtures/duplicate_net.json)",
        "$(location :voltage_divider)",
        "$(location :frontend_equivalence)",
        "$(location tools/kicad/validate_project.py)",
        "$(location tools/kicad/normalize_drc.py)",
        "$(location tools/kicad/fixtures/erc-clean.json)",
    ],
    data = [
        "examples/voltage_divider.circuitc",
        "tools/frontend/fixtures/duplicate_net.circuitc",
        "tools/frontend/fixtures/duplicate_net.json",
        "tools/kicad/fixtures/erc-clean.json",
        "tools/kicad/normalize_drc.py",
        "tools/kicad/validate_project.py",
        ":frontend_equivalence",
        ":voltage_divider",
        "//cmd/circuitc",
    ],
)

sh_test(
    name = "kicad_report_normalizer_test",
    srcs = ["tools/kicad/normalize_drc_test.sh"],
    args = [
        "$(location tools/kicad/normalize_drc.py)",
        "$(location tools/kicad/fixtures/drc-first.json)",
        "$(location tools/kicad/fixtures/drc-second.json)",
        "$(location tools/kicad/fixtures/drc-unexpected.json)",
        "$(location tools/kicad/fixtures/erc-clean.json)",
        "$(location tools/kicad/fixtures/identity-map.json)",
        "$(location tools/kicad/fixtures/identity-map-null-location.json)",
    ],
    data = [
        "tools/kicad/fixtures/drc-first.json",
        "tools/kicad/fixtures/drc-second.json",
        "tools/kicad/fixtures/drc-unexpected.json",
        "tools/kicad/fixtures/erc-clean.json",
        "tools/kicad/fixtures/identity-map.json",
        "tools/kicad/fixtures/identity-map-null-location.json",
        "tools/kicad/normalize_drc.py",
    ],
)

sh_test(
    name = "kicad_project_validator_test",
    srcs = ["tools/kicad/validate_project_test.sh"],
    args = [
        "$(location tools/kicad/validate_project.py)",
        "$(location tools/kicad/fixtures/project-valid.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-json.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-structure.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-content.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-meta-filename.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-meta-shape.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-version.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-version-type.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-libraries-shape.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-libraries-content.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-list-content.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-extra-field.kicad_pro)",
        "$(location tools/kicad/fixtures/project-invalid-root.kicad_pro)",
    ],
    data = [
        "tools/kicad/fixtures/project-invalid-content.kicad_pro",
        "tools/kicad/fixtures/project-invalid-extra-field.kicad_pro",
        "tools/kicad/fixtures/project-invalid-json.kicad_pro",
        "tools/kicad/fixtures/project-invalid-libraries-content.kicad_pro",
        "tools/kicad/fixtures/project-invalid-libraries-shape.kicad_pro",
        "tools/kicad/fixtures/project-invalid-list-content.kicad_pro",
        "tools/kicad/fixtures/project-invalid-meta-filename.kicad_pro",
        "tools/kicad/fixtures/project-invalid-meta-shape.kicad_pro",
        "tools/kicad/fixtures/project-invalid-root.kicad_pro",
        "tools/kicad/fixtures/project-invalid-structure.kicad_pro",
        "tools/kicad/fixtures/project-invalid-version.kicad_pro",
        "tools/kicad/fixtures/project-invalid-version-type.kicad_pro",
        "tools/kicad/fixtures/project-valid.kicad_pro",
        "tools/kicad/validate_project.py",
    ],
)

sh_test(
    name = "kicad10_drc_test",
    srcs = ["tools/kicad/kicad10_drc_test.sh"],
    args = [
        "$(location :voltage_divider)",
        "$(location tools/kicad/normalize_drc.py)",
        "$(location //cmd/circuitc)",
        "$(location examples/voltage_divider.circuitc)",
        "$(location tools/kicad/validate_project.py)",
        "$(location examples/physical_no_connect.circuitc)",
    ],
    data = [
        "examples/physical_no_connect.circuitc",
        "examples/voltage_divider.circuitc",
        "tools/kicad/normalize_drc.py",
        "tools/kicad/validate_project.py",
        ":voltage_divider",
        "//cmd/circuitc",
    ],
    tags = [
        "local",
        "manual",
    ],
)
