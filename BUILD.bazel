load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:apgar_pin.bzl", "APGAR_SOURCE_REVISION")
load("//bazel:ohmnivore_pin.bzl", "OHMNIVORE_SOURCE_REVISION")

package(default_visibility = ["//visibility:private"])

RUSTC_FLAGS = ["-Dwarnings"]

cc_binary(
    name = "apgar_route_adapter",
    srcs = ["tools/routing/apgar_route_adapter.cc"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wpedantic",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@apgar//:board_ir",
        "@apgar//:candidate_contract",
        "@apgar//:candidate_policy",
        "@apgar//:cpu_astar",
        "@apgar//:geometry_compiler",
        "@apgar//:planar_route",
        "@nlohmann_json//:json",
    ],
)

rust_library(
    name = "circuitc",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["libraries/**"]) + [
        "catalogs/reference-catalog.json",
        "examples/physical_no_connect.circuitc",
        "examples/voltage_divider.circuitc",
    ],
    crate_name = "circuitc",
    crate_root = "src/lib.rs",
    data = [
        ":apgar_route_adapter",
        ":apgar_route_provenance",
        ":ohmnivore_executable",
        ":ohmnivore_provenance",
    ],
    edition = "2024",
    rustc_env = {
        "CIRCUITC_OHMNIVORE_SOURCE_REVISION": OHMNIVORE_SOURCE_REVISION,
    },
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "@crates//libc",
        "@crates//serde",
        "@crates//serde_json",
        "@crates//sha2",
    ],
)

rust_binary(
    name = "apgar_route_provenance_writer",
    srcs = ["tools/routing/provenance_writer.rs"],
    crate_name = "apgar_route_provenance_writer",
    edition = "2024",
    rustc_env = {
        "CIRCUITC_APGAR_SOURCE_REVISION": APGAR_SOURCE_REVISION,
    },
    rustc_flags = RUSTC_FLAGS,
    deps = ["@crates//sha2"],
)

rust_binary(
    name = "route_evidence_verifier",
    srcs = ["tools/routing/route_evidence_verifier.rs"],
    crate_name = "route_evidence_verifier",
    edition = "2024",
    rustc_flags = RUSTC_FLAGS,
    deps = [":circuitc"],
)

genrule(
    name = "apgar_route_provenance",
    srcs = [":apgar_route_adapter"],
    outs = ["apgar-route-provenance.txt"],
    cmd = "$(location :apgar_route_provenance_writer) $(location :apgar_route_adapter) $@",
    tools = [":apgar_route_provenance_writer"],
)

rust_binary(
    name = "ohmnivore_provenance_writer",
    srcs = ["tools/simulation/provenance_writer.rs"],
    crate_name = "ohmnivore_provenance_writer",
    edition = "2024",
    rustc_env = {
        "CIRCUITC_OHMNIVORE_SOURCE_REVISION": OHMNIVORE_SOURCE_REVISION,
    },
    rustc_flags = RUSTC_FLAGS,
    deps = ["@crates//sha2"],
)

genrule(
    name = "ohmnivore_executable",
    srcs = ["@crates//:ohmnivore__ohmnivore"],
    outs = ["ohmnivore-cpu"],
    cmd = "cp $(location @crates//:ohmnivore__ohmnivore) $@ && chmod 0555 $@",
    executable = True,
)

genrule(
    name = "ohmnivore_provenance",
    srcs = [":ohmnivore_executable"],
    outs = ["ohmnivore-provenance.txt"],
    cmd = "$(location :ohmnivore_provenance_writer) $(location :ohmnivore_executable) $@",
    tools = [":ohmnivore_provenance_writer"],
)

