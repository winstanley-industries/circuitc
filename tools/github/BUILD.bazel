load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "pr_thread_status_lib",
    srcs = [
        "__init__.py",
        "pr_thread_status.py",
    ],
)

py_binary(
    name = "pr_thread_status",
    srcs = ["main.py"],
    legacy_create_init = 0,
    main = "main.py",
    python_version = "3.13",
    deps = [":pr_thread_status_lib"],
)

py_test(
    name = "pr_thread_status_test",
    size = "small",
    srcs = ["pr_thread_status_test.py"],
    legacy_create_init = 0,
    python_version = "3.13",
    deps = [":pr_thread_status_lib"],
)

sh_test(
    name = "pr_thread_status_cli_test",
    srcs = ["pr_thread_status_cli_test.sh"],
    args = [
        "$(location :pr_thread_status)",
        "$(location fixtures/gh)",
    ],
    data = [
        "fixtures/gh",
        ":pr_thread_status",
    ],
)
